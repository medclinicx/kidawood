# Copy this file to .env.local for local work, and add the same
# variables in the Vercel project settings for the live site.

# The project ID from your Sanity project dashboard at sanity.io.
# Leave this unset and the site uses the local starter articles
# in lib/articles.ts instead.
NEXT_PUBLIC_SANITY_PROJECT_ID=

# The Sanity dataset to read articles from. Defaults to "production"
# when unset.
NEXT_PUBLIC_SANITY_DATASET=production
